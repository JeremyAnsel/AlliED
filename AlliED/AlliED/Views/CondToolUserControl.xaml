<UserControl x:Class="AlliED.Views.CondToolUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:AlliED.Views"
             xmlns:localConverters="clr-namespace:AlliED.Converters"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="370"
             d:DesignWidth="379"
             UseLayoutRounding="True"
             FontSize="10">
    <Canvas>
        <TextBlock x:Name="Label1"
                   Canvas.Left="242"
                   Canvas.Top="60"
                   Width="40"
                   Height="13"
                   Text="(Region)" />
        <GroupBox x:Name="Selectors"
                  Canvas.Left="0"
                  Canvas.Top="0"
                  Width="359"
                  Height="86">
            <Canvas>
                <TextBlock x:Name="Label18"
                           Canvas.Left="163"
                           Canvas.Top="12"
                           Width="9"
                           Height="13"
                           Text="of" />
                <TextBlock x:Name="Label19"
                           Canvas.Left="158"
                           Canvas.Top="34"
                           Width="22"
                           Height="13"
                           Text="must" />
                <Button x:Name="AddToClipBtn"
                        Canvas.Left="334"
                        Canvas.Top="34"
                        Width="15"
                        Height="17"
                        ToolTip="Add to Clipboard">
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:CondToolWindowResources.AddToClipBtnGlyph}, Converter={x:Static localConverters:StringImageConverter.Default}}" />
                </Button>
                <TextBlock x:Name="Label2"
                           Canvas.Left="10"
                           Canvas.Top="62"
                           Width="93"
                           Height="13"
                           Text="Active sequence: #" />
                <ComboBox x:Name="PercentBox"
                          Canvas.Left="9"
                          Canvas.Top="8"
                          Width="143"
                          Height="21"
                          ItemsSource="{x:Static local:CondToolWindowResources.PercentBoxStrings}" />
                <ComboBox x:Name="ClassBox"
                          Canvas.Left="186"
                          Canvas.Top="8"
                          Width="143"
                          Height="21"
                          ItemsSource="{x:Static local:CondToolWindowResources.ClassBoxStrings}" />
                <ComboBox x:Name="IndexBox"
                          Canvas.Left="9"
                          Canvas.Top="32"
                          Width="143"
                          Height="21" />
                <ComboBox x:Name="CondBox"
                          Canvas.Left="186"
                          Canvas.Top="32"
                          Width="143"
                          Height="21"
                          ItemsSource="{x:Static local:CondToolWindowResources.CondBoxStrings}" />
                <TextBox x:Name="CondUnk2"
                         Canvas.Left="107"
                         Canvas.Top="58"
                         Width="45"
                         Height="21" />
                <ComboBox x:Name="RegionFGBox"
                          Canvas.Left="186"
                          Canvas.Top="58"
                          Width="143"
                          Height="21" />
            </Canvas>
        </GroupBox>
        <Canvas x:Name="StrPanel"
                Canvas.Left="0"
                Canvas.Top="249"
                Width="359"
                Height="99">
            <GroupBox x:Name="GroupBox20"
                      Canvas.Left="8"
                      Canvas.Top="0"
                      Width="345"
                      Height="97">
                <Canvas>
                    <TextBlock x:Name="Label62"
                               Canvas.Left="9"
                               Canvas.Top="17"
                               Width="52"
                               Height="13"
                               Text="Incomplete" />
                    <TextBlock x:Name="Label63"
                               Canvas.Left="20"
                               Canvas.Top="42"
                               Width="41"
                               Height="13"
                               Text="Success" />
                    <TextBlock x:Name="Label73"
                               Canvas.Left="45"
                               Canvas.Top="65"
                               Width="16"
                               Height="13"
                               Text="Fail" />
                    <TextBox x:Name="FGStrFail"
                             Tag="3"
                             Canvas.Left="71"
                             Canvas.Top="63"
                             Width="263"
                             Height="21"
                             MaxLength="63"
                             Background="#000000"
                             Foreground="Red"
                             d:Text="some text" />
                    <TextBox x:Name="FGStrSucc"
                             Tag="2"
                             Canvas.Left="71"
                             Canvas.Top="40"
                             Width="263"
                             Height="21"
                             MaxLength="63"
                             Background="#000000"
                             Foreground="Lime"
                             d:Text="some text" />
                    <TextBox x:Name="FGStrIncomp"
                             Tag="1"
                             Canvas.Left="71"
                             Canvas.Top="16"
                             Width="263"
                             Height="21"
                             MaxLength="63"
                             Background="#000000"
                             Foreground="Yellow"
                             d:Text="some text" />
                </Canvas>
            </GroupBox>
        </Canvas>
        <Canvas x:Name="Cond12Panel"
                ClipToBounds="True"
                Canvas.Left="0"
                Canvas.Top="86"
                Width="359"
                Height="163">
            <GroupBox x:Name="Panel13"
                      Canvas.Left="8"
                      Canvas.Top="1"
                      Width="345"
                      Height="68"
                      Background="#BFBFFF">
                <Canvas>
                    <TextBlock x:Name="Cond2Lab"
                               Tag="2"
                               Canvas.Left="4"
                               Canvas.Top="47"
                               Width="Auto"
                               Height="13"
                               Text="----" />
                    <TextBlock x:Name="Cond1Lab"
                               Tag="1"
                               Canvas.Left="5"
                               Canvas.Top="7"
                               Width="Auto"
                               Height="13"
                               Text="----" />
                    <RadioButton x:Name="and2And"
                                 Canvas.Left="144"
                                 Canvas.Top="24"
                                 Width="45"
                                 Height="17"
                                 Content="And"
                                 IsChecked="True" />
                    <RadioButton x:Name="and2Or"
                                 Canvas.Left="206"
                                 Canvas.Top="24"
                                 Width="37"
                                 Height="17"
                                 Content="Or" />
                </Canvas>
            </GroupBox>
            <RadioButton x:Name="GlbAnd"
                         Canvas.Left="152"
                         Canvas.Top="71"
                         Width="45"
                         Height="17"
                         Content="And"
                         IsChecked="True" />
            <RadioButton x:Name="GlbOr"
                         Canvas.Left="214"
                         Canvas.Top="71"
                         Width="37"
                         Height="17"
                         Content="Or" />
            <GroupBox x:Name="Panel14"
                      Canvas.Left="8"
                      Canvas.Top="91"
                      Width="345"
                      Height="67"
                      Background="#BFBFFF">
                <Canvas>
                    <TextBlock x:Name="Cond3Lab"
                               Tag="3"
                               Canvas.Left="4"
                               Canvas.Top="6"
                               Width="Auto"
                               Height="13"
                               Text="----" />
                    <TextBlock x:Name="Cond4Lab"
                               Tag="4"
                               Canvas.Left="4"
                               Canvas.Top="47"
                               Width="Auto"
                               Height="13"
                               Text="----" />
                    <RadioButton x:Name="and4And"
                                 Canvas.Left="144"
                                 Canvas.Top="25"
                                 Width="45"
                                 Height="17"
                                 Content="And"
                                 IsChecked="True" />
                    <RadioButton x:Name="And4Or"
                                 Canvas.Left="206"
                                 Canvas.Top="25"
                                 Width="37"
                                 Height="17"
                                 Content="Or" />
                </Canvas>
            </GroupBox>
        </Canvas>
    </Canvas>
</UserControl>
