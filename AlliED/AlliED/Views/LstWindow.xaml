<Window x:Class="AlliED.Views.LstWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlliED.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Mission.lst Files"
        Height="502"
        Width="635"
        Left="257"
        Top="156"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        FontSize="10">
    <Canvas>
        <TabControl x:Name="PageControl1"
                    Canvas.Left="2"
                    Canvas.Top="2"
                    Width="379"
                    Height="459">
            <TabItem x:Name="MissionPg"
                     Header="Mission"
                     Tag="0">
                <ListBox x:Name="MissionLstMemo" />
            </TabItem>
            <TabItem x:Name="MeleePg"
                     Header="Melee"
                     Tag="1">
                <ListBox x:Name="MeleeLstMemo" />
            </TabItem>
        </TabControl>
        <GroupBox x:Name="GroupBox1"
                  Canvas.Left="398"
                  Canvas.Top="197"
                  Width="223"
                  Height="210"
                  Header="New Mission Entry">
            <Canvas>
                <TextBlock x:Name="Label9"
                           Canvas.Left="15"
                           Canvas.Top="24"
                           Width="82"
                           Height="13"
                           Text="Next availiable #:" />
                <TextBlock x:Name="Label8"
                           Canvas.Left="15"
                           Canvas.Top="74"
                           Width="54"
                           Height="13"
                           Text="Mission File" />
                <TextBlock x:Name="Label1"
                           Canvas.Left="15"
                           Canvas.Top="124"
                           Width="91"
                           Height="13"
                           Text="Mission Description" />
                <TextBox x:Name="LstNum"
                         Canvas.Left="15"
                         Canvas.Top="40"
                         Width="195"
                         Height="21" />
                <TextBox x:Name="Edit2"
                         Canvas.Left="15"
                         Canvas.Top="91"
                         Width="195"
                         Height="21" />
                <TextBox x:Name="Edit1"
                         Canvas.Left="15"
                         Canvas.Top="140"
                         Width="195"
                         Height="21" />
                <Button x:Name="AutoAddBut"
                        Canvas.Left="64"
                        Canvas.Top="173"
                        Width="99"
                        Height="25"
                        Content="_Add" />
            </Canvas>
        </GroupBox>
        <Button x:Name="BitBtn1"
                Canvas.Left="481"
                Canvas.Top="429"
                Width="65"
                Height="24"
                Content="_Cancel"
                Click="BitBtn1_Click" />
        <Button x:Name="OKBtn"
                Canvas.Left="556"
                Canvas.Top="429"
                Width="65"
                Height="24"
                Content="_OK"
                Click="OKBtn_Click" />
        <GroupBox x:Name="GroupBox3"
                  Canvas.Left="398"
                  Canvas.Top="20"
                  Width="223"
                  Height="163"
                  Header="New Battle Header">
            <Canvas>
                <TextBlock x:Name="Label3"
                           Canvas.Left="13"
                           Canvas.Top="22"
                           Width="65"
                           Height="13"
                           Text="Next Battle #:" />
                <TextBlock x:Name="Label4"
                           Canvas.Left="15"
                           Canvas.Top="68"
                           Width="61"
                           Height="13"
                           Text="Battle Name:" />
                <TextBox x:Name="BattleNum"
                         Canvas.Left="13"
                         Canvas.Top="38"
                         Width="195"
                         Height="21" />
                <TextBox x:Name="BattleDesc"
                         Canvas.Left="15"
                         Canvas.Top="84"
                         Width="195"
                         Height="21" />
                <Button x:Name="Button1"
                        Canvas.Left="62"
                        Canvas.Top="124"
                        Width="99"
                        Height="25"
                        Content="A_dd" />
            </Canvas>
        </GroupBox>
        <Button x:Name="BackupLstBtn"
                Canvas.Left="404"
                Canvas.Top="429"
                Width="65"
                Height="25"
                Content="_Backup" />
    </Canvas>
</Window>
