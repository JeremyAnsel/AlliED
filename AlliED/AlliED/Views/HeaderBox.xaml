<Window x:Class="AlliED.Views.HeaderBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlliED.Views"
        xmlns:localConverters="clr-namespace:AlliED.Converters"
        xmlns:localModels="clr-namespace:AlliED.Models"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Mission Parameters"
        Height="477"
        Width="527"
        Left="224"
        Top="176"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        FontSize="10">
    <Canvas>
        <Button x:Name="CancelBtn"
                Canvas.Left="336"
                Canvas.Top="410"
                Width="75"
                Height="25"
                Content="_Cancel"
                Click="CancelBtn_Click" />
        <Button x:Name="OKBtn"
                Canvas.Left="430"
                Canvas.Top="410"
                Width="75"
                Height="25"
                Content="_OK"
                Click="OKBtn_Click" />
        <TabControl x:Name="PageControl1"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    Width="517"
                    Height="405">
            <TabItem x:Name="Settings"
                     Header="Settings">
                <Canvas>
                    <GroupBox x:Name="Bevel2"
                              Canvas.Left="8"
                              Canvas.Top="328"
                              Width="493"
                              Height="39" />
                    <TextBlock x:Name="Label5"
                               Canvas.Left="18"
                               Canvas.Top="10"
                               Width="104"
                               Height="13"
                               Text="Mission type / Hangar" />
                    <TextBlock x:Name="Label1"
                               Canvas.Left="16"
                               Canvas.Top="66"
                               Width="70"
                               Height="13"
                               Text="Region Names" />
                    <TextBlock x:Name="Label4"
                               Canvas.Left="288"
                               Canvas.Top="10"
                               Width="47"
                               Height="13"
                               Text="Time Limit" />
                    <TextBlock x:Name="Label6"
                               Canvas.Left="18"
                               Canvas.Top="188"
                               Width="91"
                               Height="13"
                               Text="Mothership Insignia" />
                    <TextBlock x:Name="Label2"
                               Canvas.Left="348"
                               Canvas.Top="66"
                               Width="51"
                               Height="13"
                               Text="IFF Names" />
                    <TextBlock x:Name="Label7"
                               Canvas.Left="152"
                               Canvas.Top="188"
                               Width="97"
                               Height="13"
                               Text="Mothership Insignia?" />
                    <TextBlock x:Name="Label10"
                               Canvas.Left="380"
                               Canvas.Top="10"
                               Width="72"
                               Height="13"
                               Text="Tactical Officer" />
                    <ComboBox x:Name="HangarBox"
                              Canvas.Left="16"
                              Canvas.Top="28"
                              Width="235"
                              Height="21"
                              ItemsSource="{x:Static local:HeaderBoxResources.HangarBoxStrings}" />
                    <CheckBox x:Name="U6"
                              Canvas.Left="16"
                              Canvas.Top="268"
                              Width="81"
                              Height="17"
                              Content="Unknown 1" />
                    <CheckBox x:Name="U3"
                              Canvas.Left="16"
                              Canvas.Top="286"
                              Width="79"
                              Height="17"
                              Content="Unknown 2" />
                    <ListView x:Name="RegionNameGrid"
                              Canvas.Left="16"
                              Canvas.Top="80"
                              Width="293"
                              Height="105"
                              Tag="1"
                              SelectionMode="Single"
                              ItemsSource="{Binding RegionNameCollection}"
                              IsSynchronizedWithCurrentItem="True">
                        <d:ListView.Items>
                            <localModels:CollectionTextItem Text="Region 1" />
                            <localModels:CollectionTextItem Text="Region 2" />
                            <localModels:CollectionTextItem Text="Region 3" />
                            <localModels:CollectionTextItem Text="Region 4" />
                        </d:ListView.Items>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="25">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <Binding ConverterParameter="1">
                                                        <Binding.Converter>
                                                            <localConverters:ItemIndexConverter DataContext="{Binding Source={x:Reference RegionNameGrid}, Path=ItemsSource}" />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="180">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Width="160"
                                                     Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ListView x:Name="HeaderStringGrid"
                              Canvas.Left="340"
                              Canvas.Top="80"
                              Width="153"
                              Height="105"
                              Tag="1"
                              SelectionMode="Single"
                              ItemsSource="{Binding HeaderStringCollection}"
                              IsSynchronizedWithCurrentItem="True">
                        <d:ListView.Items>
                            <localModels:CollectionTextItem Text="IFF 1" />
                            <localModels:CollectionTextItem Text="IFF 2" />
                            <localModels:CollectionTextItem Text="IFF 3" />
                            <localModels:CollectionTextItem Text="IFF 4" />
                        </d:ListView.Items>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="25">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <Binding ConverterParameter="1">
                                                        <Binding.Converter>
                                                            <localConverters:ItemIndexConverter DataContext="{Binding Source={x:Reference HeaderStringGrid}, Path=ItemsSource}" />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="100">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Width="80"
                                                     Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ComboBox x:Name="MotherBox1"
                              Canvas.Left="16"
                              Canvas.Top="204"
                              Width="115"
                              Height="21"
                              ItemsSource="{x:Static local:HeaderBoxResources.MotherBox1Strings}" />
                    <TextBox x:Name="Edit2"
                             Canvas.Left="268"
                             Canvas.Top="282"
                             Width="50"
                             Height="21" />
                    <TextBox x:Name="Edit3"
                             Canvas.Left="289"
                             Canvas.Top="28"
                             Width="50"
                             Height="21" />
                    <TextBox x:Name="Edit7"
                             Canvas.Left="326"
                             Canvas.Top="282"
                             Width="50"
                             Height="21" />
                    <TextBox x:Name="Edit8"
                             Canvas.Left="384"
                             Canvas.Top="282"
                             Width="50"
                             Height="21" />
                    <TextBox x:Name="Edit10"
                             Canvas.Left="442"
                             Canvas.Top="282"
                             Width="50"
                             Height="21" />
                    <ComboBox x:Name="MotherBox2"
                              Canvas.Left="150"
                              Canvas.Top="204"
                              Width="115"
                              Height="21" />
                    <CheckBox x:Name="C1"
                              Tag="1"
                              Canvas.Left="74"
                              Canvas.Top="338"
                              Width="37"
                              Height="17"
                              Content="Use" />
                    <CheckBox  x:Name="C2"
                               Tag="2"
                               Canvas.Left="201"
                               Canvas.Top="338"
                               Width="45"
                               Height="17"
                               Content="Use" />
                    <CheckBox x:Name="C3"
                              Tag="3"
                              Canvas.Left="329"
                              Canvas.Top="338"
                              Width="43"
                              Height="17"
                              Content="Use" />
                    <CheckBox x:Name="C4"
                              Tag="4"
                              Canvas.Left="456"
                              Canvas.Top="338"
                              Width="41"
                              Height="17"
                              Content="Use" />
                    <TextBox x:Name="V1"
                             Tag="1"
                             Canvas.Left="20"
                             Canvas.Top="336"
                             Width="45"
                             Height="21" />
                    <TextBox x:Name="V2"
                             Tag="2"
                             Canvas.Left="147"
                             Canvas.Top="336"
                             Width="45"
                             Height="21" />
                    <TextBox x:Name="V3"
                             Tag="3"
                             Canvas.Left="275"
                             Canvas.Top="336"
                             Width="45"
                             Height="21" />
                    <TextBox x:Name="V4"
                             Tag="4"
                             Canvas.Left="402"
                             Canvas.Top="336"
                             Width="45"
                             Height="21" />
                    <CheckBox x:Name="Edit4"
                              Canvas.Left="16"
                              Canvas.Top="250"
                              Width="205"
                              Height="17"
                              Content="End mission when goals are complete" />
                    <ComboBox x:Name="Edit5"
                              Canvas.Left="378"
                              Canvas.Top="28"
                              Width="113"
                              Height="21"
                              ItemsSource="{x:Static local:HeaderBoxResources.Edit5Strings}" />
                </Canvas>
            </TabItem>
            <TabItem x:Name="Part2"
                     Header="Strings">
                <Canvas>
                    <GroupBox x:Name="Bevel1"
                              Canvas.Left="256"
                              Canvas.Top="14"
                              Width="243"
                              Height="347" />
                    <TextBlock x:Name="Label8"
                               Canvas.Left="274"
                               Canvas.Top="306"
                               Width="138"
                               Height="13"
                               Text="Unknowns per above strings:" />
                    <TextBlock x:Name="Label3"
                               Canvas.Left="18"
                               Canvas.Top="10"
                               Width="98"
                               Height="13"
                               Text="Global Group Names" />
                    <TextBlock x:Name="Label9"
                               Canvas.Left="272"
                               Canvas.Top="22"
                               Width="126"
                               Height="13"
                               Text="16 strings - Special Cargo ?" />
                    <ListView x:Name="Str3Grid"
                              Canvas.Left="14"
                              Canvas.Top="28"
                              Width="220"
                              Height="335"
                              Tag="1"
                              SelectionMode="Single"
                              ItemsSource="{Binding Str3Collection}"
                              IsSynchronizedWithCurrentItem="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="25">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <Binding>
                                                        <Binding.Converter>
                                                            <localConverters:ItemIndexConverter DataContext="{Binding Source={x:Reference Str3Grid}, Path=ItemsSource}" />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Width="140"
                                                     Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <ListView x:Name="Str2Grid"
                              Canvas.Left="268"
                              Canvas.Top="40"
                              Width="220"
                              Height="260"
                              Tag="1"
                              SelectionMode="Single"
                              ItemsSource="{Binding Str2Collection}"
                              IsSynchronizedWithCurrentItem="True">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="25">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Text>
                                                    <Binding ConverterParameter="1">
                                                        <Binding.Converter>
                                                            <localConverters:ItemIndexConverter DataContext="{Binding Source={x:Reference Str2Grid}, Path=ItemsSource}" />
                                                        </Binding.Converter>
                                                    </Binding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Width="160">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBox Width="140"
                                                     Text="{Binding Text, UpdateSourceTrigger=LostFocus}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <TextBox x:Name="Str2_5"
                             Tag="5"
                             Canvas.Left="274"
                             Canvas.Top="326"
                             Width="47"
                             Height="21" />
                    <TextBox x:Name="Str2_9"
                             Tag="9"
                             Canvas.Left="355"
                             Canvas.Top="326"
                             Width="47"
                             Height="21" />
                    <TextBox x:Name="Str2_12"
                             Tag="12"
                             Canvas.Left="436"
                             Canvas.Top="326"
                             Width="47"
                             Height="21" />
                </Canvas>
            </TabItem>
        </TabControl>
    </Canvas>
</Window>
