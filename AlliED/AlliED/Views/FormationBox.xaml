<Window x:Class="AlliED.Views.FormationBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlliED.Views"
        xmlns:localConverters="clr-namespace:AlliED.Converters"
        xmlns:localControls="clr-namespace:AlliED.Controls"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Flight Group Formations"
        Height="460"
        Width="502"
        Left="66"
        Top="56"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        FontSize="10">
    <Canvas>
        <Image x:Name="Image1"
               Canvas.Left="-2"
               Canvas.Top="400"
               Width="37"
               Height="19"
               Stretch="Uniform"
               Source="{Binding Source={x:Static local:FormationBoxResources.Image1}, Converter={x:Static localConverters:StringImageConverter.Default}}"
               Visibility="Collapsed"
               d:Visibility="Visible" />
        <Grid x:Name="Panel1"
              Canvas.Left="0"
              Canvas.Top="2"
              Width="501"
              Height="391"
              Background="#000000">
            <localControls:PaintBoxControl x:Name="PaintBox1" />
        </Grid>
        <Button x:Name="PrevForm"
                Canvas.Left="200"
                Canvas.Top="396"
                Width="39"
                Height="23"
                Click="PrevForm_Click">
            <Image Stretch="Uniform"
                   Source="{Binding Source={x:Static local:FormationBoxResources.PrevFormGlyph}, Converter={x:Static localConverters:StringImageConverter.Default}}" />
        </Button>
        <Button x:Name="NextForm"
                Canvas.Left="246"
                Canvas.Top="396"
                Width="39"
                Height="23"
                Click="NextForm_Click">
            <Image Stretch="Uniform"
                   Source="{Binding Source={x:Static local:FormationBoxResources.NextFormGlyph}, Converter={x:Static localConverters:StringImageConverter.Default}}" />
        </Button>
        <Button x:Name="Button1"
                Canvas.Left="332"
                Canvas.Top="396"
                Width="69"
                Height="23"
                Content="_Use"
                Click="Button1_Click" />
        <Button x:Name="Button2"
                Canvas.Left="412"
                Canvas.Top="396"
                Width="69"
                Height="23"
                Content="_Cancel"
                Click="Button2_Click" />
        <CheckBox x:Name="CheckBox1"
                  Canvas.Left="30"
                  Canvas.Top="400"
                  Width="149"
                  Height="17"
                  Content="_Show for Current FG size" />
    </Canvas>
</Window>
