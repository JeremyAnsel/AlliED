<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>11.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Version>2.0.0</Version>
    <AssemblyName>AlliED</AssemblyName>
    <Company>Troy Dangerfield, Jérémy Ansel</Company>
    <Copyright>Copyright © 1999-2007 Troy Dangerfield, 2026 Jérémy Ansel</Copyright>
    <ApplicationIcon>allied.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="JeremyAnsel.DirectX.D2D1" Version="4.0.62" />
    <PackageReference Include="JeremyAnsel.DirectX.DXCommon" Version="4.0.62" />
    <PackageReference Include="JeremyAnsel.DirectX.WinCodec" Version="4.0.62" />
    <PackageReference Include="JeremyAnsel.Xwa.Opt" Version="3.0.56" />
    <PackageReference Include="JeremyAnsel.Xwa.Workspace" Version="1.0.7" />
    <PackageReference Include="PolySharp" Version="1.14.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="DotNetProjects.Extended.Wpf.Toolkit" Version="5.0.129" />
    <PackageReference Include="SharpDialogs.Wpf" Version="1.0.11" />
    <PackageReference Include="WriteableBitmapEx" Version="1.6.11" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
