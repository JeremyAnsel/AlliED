<Window x:Class="AlliED.Views.LblBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlliED.Views"
        xmlns:localControls="clr-namespace:AlliED.Controls"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Load by .lst"
        Height="467"
        Width="375"
        Left="312"
        Top="161"
        MinHeight="200"
        MinWidth="260"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        FontSize="10">
    <Canvas>
        <TabControl x:Name="TabControl1"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    Width="360"
                    Height="389"
                    SelectedIndex="0">
            <TabItem Header="Campaign" />
            <TabItem Header="Melee" />
        </TabControl>
        <localControls:CustomListBox x:Name="ListBox1"
                                     Canvas.Left="4"
                                     Canvas.Top="24"
                                     Width="352"
                                     Height="361" />
        <Button x:Name="CancelBtn"
                Canvas.Left="190"
                Canvas.Top="394"
                Width="75"
                Height="25"
                Content="_Cancel"
                Click="CancelBtn_Click" />
        <Button x:Name="OKBtn"
                Canvas.Left="278"
                Canvas.Top="394"
                Width="75"
                Height="25"
                Content="_OK"
                Click="OKBtn_Click" />
        <CheckBox x:Name="BrowseChk"
                  Canvas.Left="20"
                  Canvas.Top="398"
                  Width="57"
                  Height="17"
                  Content="Browse" />
    </Canvas>
</Window>
