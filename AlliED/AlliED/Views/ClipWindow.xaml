<Window x:Class="AlliED.Views.ClipWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlliED.Views"
        xmlns:localConverters="clr-namespace:AlliED.Converters"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="ClipForm"
        Height="413"
        Width="552"
        Left="272"
        Top="188"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        FontSize="10">
    <Canvas>
        <GroupBox x:Name="Bevel1"
                  Canvas.Left="438"
                  Canvas.Top="24"
                  Width="99"
                  Height="43" />
        <TextBlock x:Name="Label1"
                   Canvas.Left="452"
                   Canvas.Top="42"
                   Width="73"
                   Height="13"
                   Text="Speed for Map:"
                   Visibility="Collapsed"
                   d:Visibility="Visible" />
        <ListBox x:Name="ListBox1"
                 Canvas.Left="0"
                 Canvas.Top="0"
                 Width="431"
                 Height="373"
                 SelectionMode="Single" />
        <Button x:Name="CancelBtn"
                Canvas.Left="458"
                Canvas.Top="306"
                Width="69"
                Height="23"
                Content="_Cancel"
                Click="CancelBtn_Click" />
        <Button x:Name="OKBtn"
                Canvas.Left="458"
                Canvas.Top="342"
                Width="69"
                Height="23"
                Content="_Use"
                Click="OKBtn_Click" />
        <ToolBar x:Name="ToolBar1"
                 ToolBarTray.IsLocked="True"
                 Canvas.Left="439"
                 Canvas.Top="1"
                 Width="107"
                 Height="23">
            <Button x:Name="Up"
                    ToolTip="Move Up">
                <Image Stretch="Uniform"
                       Source="{Binding Source={x:Static local:Form1WindowResources.ImageList1}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=4}" />
            </Button>
            <Button x:Name="Down"
                    ToolTip="Move Down">
                <Image Stretch="Uniform"
                       Source="{Binding Source={x:Static local:Form1WindowResources.ImageList1}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=5}" />
            </Button>
            <Separator />
            <Button x:Name="InsBtn"
                    ToolTip="Insert blank"
                    Visibility="Collapsed"
                    d:Visibility="Visible">
                <Image Stretch="Uniform"
                       Source="{Binding Source={x:Static local:Form1WindowResources.ImageList1}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=45}" />
            </Button>
            <Button x:Name="DelClipBtn"
                    ToolTip="Delete">
                <Image Stretch="Uniform"
                       Source="{Binding Source={x:Static local:Form1WindowResources.ImageList1}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=7}" />
            </Button>
        </ToolBar>
        <TextBox x:Name="SpeedEd"
                 Canvas.Left="452"
                 Canvas.Top="60"
                 Width="73"
                 Height="21"
                 Text="0"
                 Visibility="Collapsed"
                 d:Visibility="Visible" />
    </Canvas>
</Window>
