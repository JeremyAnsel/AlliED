<Window x:Class="AlliED.Views.ImportBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlliED.Views"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Import Tuning Options"
        Height="335"
        Width="244"
        Left="336"
        Top="182"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        FontSize="10">
    <Canvas>
        <TextBlock x:Name="Label1"
                   Canvas.Left="55"
                   Canvas.Top="112"
                   Width="40"
                   Height="13"
                   Text="Fighters:" />
        <Button x:Name="Button1"
                Canvas.Left="85"
                Canvas.Top="268"
                Width="75"
                Height="25"
                Content="_OK"
                Click="Button1_Click" />
        <GroupBox x:Name="GroupBox1"
                  Canvas.Left="6"
                  Canvas.Top="210"
                  Width="230"
                  Height="49"
                  Header="XvT/BoP">
            <Canvas>
                <CheckBox x:Name="CheckBox6"
                          Canvas.Left="22"
                          Canvas.Top="20"
                          Width="169"
                          Height="17"
                          Content="Retain only Player 1 as Player" />
            </Canvas>
        </GroupBox>
        <TextBlock x:Name="Memo1"
                   Canvas.Left="8"
                   Canvas.Top="174"
                   Width="230"
                   Height="31"
                   TextWrapping="Wrap"
                   Text="Restricting maximum A.I. can help compensate for XWA's more effective A.I. and turbolasers." />
        <GroupBox x:Name="GroupBox2"
                  Canvas.Left="6"
                  Canvas.Top="6"
                  Width="230"
                  Height="157"
                  Header="Restrict maximum A.I. to:">
            <Canvas>
                <TextBlock x:Name="Label5"
                           Canvas.Left="51"
                           Canvas.Top="130"
                           Width="40"
                           Height="13"
                           Text="Fighters:" />
                <TextBlock x:Name="Label4"
                           Canvas.Left="42"
                           Canvas.Top="74"
                           Width="49"
                           Height="13"
                           Text="Freighters:" />
                <TextBlock x:Name="Label3"
                           Canvas.Left="27"
                           Canvas.Top="22"
                           Width="64"
                           Height="13"
                           Text="Capital Ships:" />
                <TextBlock x:Name="Label2"
                           Canvas.Left="38"
                           Canvas.Top="104"
                           Width="53"
                           Height="13"
                           Text="Transports:" />
                <TextBlock x:Name="Label6"
                           Canvas.Left="45"
                           Canvas.Top="49"
                           Width="46"
                           Height="13"
                           Text="Platforms:" />
                <ComboBox x:Name="ComboBox3"
                          Canvas.Left="105"
                          Canvas.Top="72"
                          Width="97"
                          Height="21" />
                <ComboBox x:Name="ComboBox1"
                          Canvas.Left="105"
                          Canvas.Top="18"
                          Width="97"
                          Height="21"
                          ItemsSource="{x:Static local:ImportBoxResources.ComboBox1Strings}" />
                <ComboBox x:Name="ComboBox2"
                          Canvas.Left="105"
                          Canvas.Top="45"
                          Width="97"
                          Height="21" />
                <ComboBox x:Name="ComboBox5"
                          Canvas.Left="105"
                          Canvas.Top="100"
                          Width="97"
                          Height="21" />
            </Canvas>
        </GroupBox>
        <ComboBox x:Name="ComboBox4"
                  Canvas.Left="111"
                  Canvas.Top="134"
                  Width="97"
                  Height="21" />
    </Canvas>
</Window>
