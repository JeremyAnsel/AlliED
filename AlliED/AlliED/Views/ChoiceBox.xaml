<Window x:Class="AlliED.Views.ChoiceBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlliED.Views"
        xmlns:localConverters="clr-namespace:AlliED.Converters"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="StartUp"
        Height="260"
        Width="281"
        Left="220"
        Top="169"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        FontSize="10">
    <Canvas>
        <TextBlock x:Name="ProductName"
                   Canvas.Left="84"
                   Canvas.Top="6"
                   Width="44"
                   Height="16"
                   Text="AlliED"
                   FontSize="13"
                   Foreground="Black"
                   FontWeight="Bold" />
        <TextBlock x:Name="VersionLab"
                   Canvas.Left="140"
                   Canvas.Top="8"
                   Width="53"
                   Height="13"
                   Text="Version" />
        <TextBlock x:Name="Label2"
                   Canvas.Left="75"
                   Canvas.Top="25"
                   Width="200"
                   Height="30"
                   Text="Copyright"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="Label1"
                   Canvas.Left="20"
                   Canvas.Top="55"
                   Width="250"
                   Height="13">
            <Run>Bug reports to: </Run>
            <!--<Hyperlink>allied@troyed.com</Hyperlink>-->
            <Hyperlink NavigateUri="https://github.com/JeremyAnsel/AlliED"
                       RequestNavigate="Hyperlink_RequestNavigate"
                       ToolTip="https://github.com/JeremyAnsel/AlliED">https://github.com/JeremyAnsel/AlliED</Hyperlink>
        </TextBlock>
        <TextBlock x:Name="Label3"
                   Canvas.Left="20"
                   Canvas.Top="75"
                   Width="230"
                   Height="13"
                   Text="Check the Version file for latest features"
                   Foreground="Black"
                   FontWeight="Bold" />
        <Separator x:Name="Bevel1"
                   Canvas.Left="10"
                   Canvas.Top="97"
                   Width="260"
                   Height="3" />
        <Image x:Name="ProgramIcon"
               Canvas.Left="33"
               Canvas.Top="6"
               Width="35"
               Height="35"
               Stretch="Uniform"
               Source="{Binding Source={x:Static local:ChoiceBoxResources.ProgramIcon}, Converter={x:Static localConverters:StringImageConverter.Default}}" />
        <GroupBox Header="Choose Action:"
                  Canvas.Left="21"
                  Canvas.Top="115"
                  Width="152"
                  Height="109">
            <ListBox x:Name="StartUpRadio"
                     SelectedIndex="0">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="1" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Items>
                    <RadioButton Content="Load _Existing Mission"
                                 IsChecked="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}" />
                    <RadioButton Content="Create _New Mission"
                                 IsChecked="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}" />
                    <RadioButton Content="Load Last _Used File"
                                 IsChecked="{Binding IsSelected, RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type ListBoxItem}}}" />
                </ListBox.Items>
            </ListBox>
        </GroupBox>
        <Button x:Name="OKButton"
                Canvas.Left="187"
                Canvas.Top="155"
                Width="73"
                Height="25"
                Content="_OK"
                Click="OKButton_Click" />
    </Canvas>
</Window>
