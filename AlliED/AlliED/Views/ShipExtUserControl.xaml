<UserControl x:Class="AlliED.Views.ShipExtUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:AlliED.Views"
             xmlns:localConverters="clr-namespace:AlliED.Converters"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="284"
             d:DesignWidth="491"
             UseLayoutRounding="True"
             FontSize="10">
    <Canvas>
        <TextBlock x:Name="Label93"
                   Canvas.Left="220"
                   Canvas.Top="231"
                   Width="96"
                   Height="13"
                   Text="Appears in Difficulty:"
                   Visibility="Collapsed"
                   d:Visibility="Visible" />
        <ToolBar ToolBarTray.IsLocked="True"
                 Canvas.Left="453"
                 Canvas.Top="206">
            <CheckBox x:Name="AutoLinkChk"
                      Width="17"
                      Height="17"
                      ToolTip="Autolink: Shiptype/Team/IFF">
                <Image Stretch="Uniform"
                       Source="{Binding Source={x:Static local:ShipExtWindowResources.AutoLinkChkGlyph}, Converter={x:Static localConverters:StringImageConverter.Default}}" />
            </CheckBox>
        </ToolBar>
        <GroupBox x:Name="GroupBox4"
                  Canvas.Left="8"
                  Canvas.Top="-2"
                  Width="207"
                  Height="226">
            <Canvas>
                <TextBlock x:Name="Label4"
                           Canvas.Left="18"
                           Canvas.Top="21"
                           Width="39"
                           Height="13"
                           Text="Status 1" />
                <TextBlock x:Name="Label8"
                           Canvas.Left="39"
                           Canvas.Top="69"
                           Width="16"
                           Height="13"
                           Text="A.I." />
                <TextBlock x:Name="Label28"
                           Canvas.Left="27"
                           Canvas.Top="140"
                           Width="28"
                           Height="13"
                           Text="Radio" />
                <TextBlock x:Name="Label29"
                           Canvas.Left="40"
                           Canvas.Top="93"
                           Width="15"
                           Height="13"
                           Text="IFF" />
                <TextBlock x:Name="Label30"
                           Canvas.Left="31"
                           Canvas.Top="118"
                           Width="24"
                           Height="13"
                           Text="Color" />
                <TextBlock x:Name="Label56"
                           Canvas.Left="32"
                           Canvas.Top="166"
                           Width="23"
                           Height="13"
                           Text="Form" />
                <TextBlock x:Name="Label57"
                           Canvas.Left="16"
                           Canvas.Top="197"
                           Width="39"
                           Height="13"
                           Text="Spacing" />
                <TextBlock x:Name="Label110"
                           Canvas.Left="18"
                           Canvas.Top="46"
                           Width="39"
                           Height="13"
                           Text="Status 2" />
                <ToolBar ToolBarTray.IsLocked="True"
                         Canvas.Left="112"
                         Canvas.Top="194">
                    <Button x:Name="FormBtn"
                            Width="63"
                            Height="23"
                            ToolTip="View Formations"
                            Content="View Forms" />
                </ToolBar>
                <ComboBox x:Name="IFFBox"
                          Tag="8"
                          Canvas.Left="61"
                          Canvas.Top="90"
                          Width="126"
                          Height="21" />
                <ComboBox x:Name="ColorBox"
                          Tag="11"
                          Canvas.Left="61"
                          Canvas.Top="114"
                          Width="126"
                          Height="21"
                          ItemsSource="{x:Static local:ShipExtWindowResources.ColorBoxStrings}" />
                <ComboBox x:Name="StatusBox"
                          Tag="5"
                          Canvas.Left="61"
                          Canvas.Top="18"
                          Width="126"
                          Height="21"
                          ItemsSource="{x:Static local:ShipExtWindowResources.StatusBoxStrings}" />
                <ComboBox x:Name="AIBox"
                          Tag="10"
                          Canvas.Left="61"
                          Canvas.Top="66"
                          Width="126"
                          Height="21"
                          ItemsSource="{x:Static local:ShipExtWindowResources.AIBoxStrings}" />
                <ComboBox x:Name="RadioBox"
                          Tag="12"
                          Canvas.Left="61"
                          Canvas.Top="138"
                          Width="126"
                          Height="21"
                          ItemsSource="{x:Static local:ShipExtWindowResources.RadioBoxStrings}" />
                <ComboBox x:Name="FormBox"
                          Tag="14"
                          Canvas.Left="61"
                          Canvas.Top="162"
                          Width="126"
                          Height="21"
                          ItemsSource="{x:Static local:ShipExtWindowResources.FormBoxStrings}" />
                <xctk:IntegerUpDown x:Name="SpacingSpin"
                                    Tag="15"
                                    Canvas.Left="61"
                                    Canvas.Top="194"
                                    Width="42"
                                    Height="22"
                                    Maximum="1000"
                                    Minimum="0"
                                    Value="0" />
                <ComboBox x:Name="Status2Box"
                          Tag="12"
                          Canvas.Left="61"
                          Canvas.Top="42"
                          Width="126"
                          Height="21" />
            </Canvas>
        </GroupBox>
        <GroupBox x:Name="InitSelections"
                  Canvas.Left="236"
                  Canvas.Top="-1"
                  Width="211"
                  Height="97">
            <Canvas>
                <TextBlock x:Name="Label5"
                           Canvas.Left="23"
                           Canvas.Top="17"
                           Width="31"
                           Height="13"
                           Text="Missile" />
                <TextBlock x:Name="Label6"
                           Canvas.Left="25"
                           Canvas.Top="67"
                           Width="27"
                           Height="13"
                           Text="Beam" />
                <TextBlock x:Name="Label7"
                           Canvas.Left="18"
                           Canvas.Top="44"
                           Width="37"
                           Height="13"
                           Text="Counter" />
                <ComboBox x:Name="MissleBox"
                          Tag="6"
                          Canvas.Left="61"
                          Canvas.Top="16"
                          Width="130"
                          Height="21"
                          Background="#BFBFFF"
                          ItemsSource="{x:Static local:ShipExtWindowResources.MissleBoxStrings}" />
                <ComboBox x:Name="BeamBox"
                          Tag="7"
                          Canvas.Left="61"
                          Canvas.Top="64"
                          Width="130"
                          Height="21"
                          Background="#BFBFFF"
                          ItemsSource="{x:Static local:ShipExtWindowResources.BeamBoxStrings}" />
                <ComboBox x:Name="CounterBox"
                          Tag="10"
                          Canvas.Left="61"
                          Canvas.Top="40"
                          Width="130"
                          Height="21"
                          Background="#BFBFFF"
                          ItemsSource="{x:Static local:ShipExtWindowResources.CounterBoxStrings}" />
            </Canvas>
        </GroupBox>
        <GroupBox x:Name="GroupBox6"
                  Canvas.Left="236"
                  Canvas.Top="112"
                  Width="211"
                  Height="112"
                  Header="Cargo">
            <Canvas>
                <TextBlock x:Name="Label37"
                           Canvas.Left="27"
                           Canvas.Top="87"
                           Width="31"
                           Height="13"
                           Text="Ship#:" />
                <TextBlock x:Name="Label32"
                           Canvas.Left="22"
                           Canvas.Top="22"
                           Width="37"
                           Height="13"
                           Text="Default:" />
                <TextBlock x:Name="Label31"
                           Canvas.Left="22"
                           Canvas.Top="48"
                           Width="38"
                           Height="13"
                           Text="Special:" />
                <TextBlock x:Name="Label45"
                           Canvas.Left="22"
                           Canvas.Top="74"
                           Width="35"
                           Height="13"
                           Text="Special" />
                <TextBlock x:Name="Label98"
                           Canvas.Left="65"
                           Canvas.Top="47"
                           Width="119"
                           Height="13"
                           Text="(Special ship is not in FG)" />
                <Button x:Name="PickBDrops"
                        Canvas.Left="34"
                        Canvas.Top="78"
                        Width="23"
                        Height="22"
                        ToolTip="Choose Backdrop"
                        Visibility="Collapsed"
                        d:Visibility="Visible">
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:ShipExtWindowResources.PickBDropsGlyph}, Converter={x:Static localConverters:StringImageConverter.Default}}" />
                </Button>
                <CheckBox x:Name="RandomChk"
                          Tag="2"
                          Canvas.Left="119"
                          Canvas.Top="80"
                          Width="64"
                          Height="16"
                          Content="Random" />
                <ComboBox x:Name="SpecShpSpin"
                          Tag="1"
                          Canvas.Left="64"
                          Canvas.Top="78"
                          Width="43"
                          Height="21" />
                <ComboBox x:Name="CargoEd"
                          Canvas.Left="64"
                          Canvas.Top="18"
                          Width="121"
                          Height="21" />
                <ComboBox x:Name="SpecCargEd"
                          Canvas.Left="64"
                          Canvas.Top="46"
                          Width="121"
                          Height="21" />
            </Canvas>
        </GroupBox>
        <ComboBox x:Name="AppearBox"
                  Tag="30"
                  Canvas.Left="320"
                  Canvas.Top="227"
                  Width="130"
                  Height="21"
                  ItemsSource="{x:Static local:ShipExtWindowResources.AppearBoxStrings}"
                  Visibility="Collapsed"
                  d:Visibility="Visible" />
    </Canvas>
</UserControl>
