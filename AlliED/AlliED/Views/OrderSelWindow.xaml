<Window x:Class="AlliED.Views.OrderSelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlliED.Views"
        xmlns:localConverters="clr-namespace:AlliED.Converters"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Orders"
        Height="125"
        Width="350"
        Left="419"
        Top="317"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        FontSize="10">
    <Canvas>
        <TabControl x:Name="RegionTabs"
                    Canvas.Left="311"
                    Canvas.Top="0"
                    Width="22"
                    Height="80"
                    TabStripPlacement="Left">
            <TabItem Tag="1"
                     Width="20"
                     Height="20">
                <TabItem.Header>
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:Form1WindowResources.ImageList2}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=0}" />
                </TabItem.Header>
            </TabItem>
            <TabItem Tag="2"
                     Width="20"
                     Height="20">
                <TabItem.Header>
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:Form1WindowResources.ImageList2}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=1}" />
                </TabItem.Header>
            </TabItem>
            <TabItem Tag="3"
                     Width="20"
                     Height="20">
                <TabItem.Header>
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:Form1WindowResources.ImageList2}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=2}" />
                </TabItem.Header>
            </TabItem>
            <TabItem Tag="4"
                     Width="20"
                     Height="20">
                <TabItem.Header>
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:Form1WindowResources.ImageList2}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=3}" />
                </TabItem.Header>
            </TabItem>
        </TabControl>
        <!--<ListBox x:Name="OrderSelBox"
                 Canvas.Left="0"
                 Canvas.Top="0"
                 Width="311"
                 Height="80"
                 Background="#BFBFFF"
                 ItemsSource="{Binding OrderSelCollection}" />-->
        <ListBox x:Name="OrderSelBox"
                 Canvas.Left="0"
                 Canvas.Top="0"
                 Width="311"
                 Height="80"
                 Background="#BFBFFF"
                 ItemsSource="{Binding OrderSelCollection}" />
    </Canvas>
</Window>
