<Window x:Class="AlliED.Views.LibWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AlliED.Views"
        xmlns:localControls="clr-namespace:AlliED.Controls"
        xmlns:localConverters="clr-namespace:AlliED.Converters"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="Dialog"
        Height="508"
        Width="575"
        Left="257"
        Top="149"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterOwner"
        FontSize="10">
    <Canvas>
        <localControls:CustomListBox x:Name="LibShipList"
                                     Canvas.Left="0"
                                     Canvas.Top="26"
                                     Width="575"
                                     Height="482"
                                     Background="#000000"
                                     Foreground="White" />
        <ToolBarTray x:Name="ControlBar1"
                     IsLocked="True"
                     Canvas.Left="0"
                     Canvas.Top="0"
                     Width="575"
                     Height="26">
            <ToolBar x:Name="ToolBar2"
                     Width="93"
                     Height="22">
                <Button x:Name="NewLibBut"
                        ToolTip="New FG Library">
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:Form1WindowResources.ImageList1}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=0}" />
                </Button>
                <Button x:Name="LoadLibBut"
                        ToolTip="Load FG Library">
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:Form1WindowResources.ImageList1}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=1}" />
                </Button>
                <Button x:Name="SaveAsLibBut"
                        ToolTip="Save As FG Library">
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:Form1WindowResources.ImageList1}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=2}" />
                </Button>
                <Button x:Name="SaveLibBut"
                        ToolTip="Save FG Library">
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:Form1WindowResources.ImageList1}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=3}" />
                </Button>
            </ToolBar>
            <ToolBar x:Name="ToolBar1"
                     Width="131"
                     Height="22">
                <Button x:Name="AddBut"
                        ToolTip="Add Library selections to Mission">
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:Form1WindowResources.ImageList1}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=26}" />
                </Button>
                <Button x:Name="GrabFGBut"
                        ToolTip="Save selected FGs in Mission to Library">
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:Form1WindowResources.ImageList1}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=20}" />
                </Button>
                <Separator />
                <Button x:Name="LibUpBut">
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:Form1WindowResources.ImageList1}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=4}" />
                </Button>
                <Button x:Name="LibDownBut">
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:Form1WindowResources.ImageList1}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=5}" />
                </Button>
                <Separator />
                <Button x:Name="DeleteLibFGBut">
                    <Image Stretch="Uniform"
                           Source="{Binding Source={x:Static local:Form1WindowResources.ImageList1}, Converter={x:Static localConverters:StringImageListSelectConverter.Default}, ConverterParameter=7}" />
                </Button>
            </ToolBar>
        </ToolBarTray>
    </Canvas>
</Window>
